// ==========================================================
// DETECTAR EMBED69
// ==========================================================

function isEmbed69(
    url
) {

    try {

        return new URL(
            url
        )
            .hostname
            .toLowerCase()
            .includes(
                "embed69.org"
            );

    } catch {

        return false;
    }
}


