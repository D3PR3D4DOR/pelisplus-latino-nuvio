// ==========================================================
// DEDUPLICAR STREAMS
// ==========================================================

function deduplicateStreams(
    streams
) {

    const seen =
        new Set();

    return streams.filter(
        stream => {

            if (
                !stream?.url
            ) {

                return false;
            }

            if (
                seen.has(
                    stream.url
                )
            ) {

                return false;
            }

            seen.add(
                stream.url
            );

            return true;
        }
    );
}





